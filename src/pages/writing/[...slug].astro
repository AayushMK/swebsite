---
import Base from '../../layouts/Base.astro';
import Inkblot from '../../components/Inkblot.astro';
import { getPosts, TOPICS, url, formatDate, readingTime } from '../../lib/site';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post, i) => ({
    params: { slug: post.slug },
    props: { post, newer: posts[i - 1], older: posts[i + 1] },
  }));
}
const { post, newer, older } = Astro.props;
const { Content } = await post.render();
const topic = TOPICS[post.data.topic];
---
<Base title={post.data.title} description={post.data.description}>
  <article class="wrap">
    <header class="head">
      <div class="blot"><Inkblot seed={post.data.title} unfold /></div>
      <p class="meta">
        <a href={url(`topics/${post.data.topic}/`)}>{topic.name}</a>
        <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
        <span>{readingTime(post.body)}</span>
      </p>
      <h1>{post.data.title}</h1>
      <p class="lede">{post.data.description}</p>
    </header>
    <div class="prose">
      <Content />
    </div>
  </article>

  {(newer || older) && (
    <nav class="wrap pager" aria-label="More writing">
      {older ? (
        <a href={url(`writing/${older.slug}/`)}><span>Previous</span>{older.data.title}</a>
      ) : <span />}
      {newer && (
        <a class="next" href={url(`writing/${newer.slug}/`)}><span>Next</span>{newer.data.title}</a>
      )}
    </nav>
  )}
</Base>

<style>
  article { padding-top: 2rem; }
  .head { max-width: var(--measure); margin-bottom: 3rem; }
  .blot { width: 7rem; margin-bottom: 2rem; }
  .meta {
    display: flex; flex-wrap: wrap; gap: 0.25rem 1.1rem;
    margin: 0; font-size: var(--step--1); color: var(--ink-soft);
  }
  .meta a { color: var(--accent); text-decoration: none; }
  h1 {
    margin: 0.75rem 0 0;
    font-size: var(--step-3);
    font-weight: 380;
    line-height: 1.12;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }
  .lede { margin: 1rem 0 0; font-size: 1.3rem; font-style: italic; color: var(--ink-soft); line-height: 1.5; }
  .pager {
    display: grid; grid-template-columns: 1fr 1fr; gap: 2rem;
    margin-top: 5rem; padding-top: 2rem; border-top: 1px solid var(--rule);
  }
  .pager a { text-decoration: none; font-size: 1.1rem; line-height: 1.35; }
  .pager span { display: block; font-size: var(--step--1); color: var(--ink-soft); margin-bottom: 0.3rem; }
  .pager .next { text-align: right; }
  @media (max-width: 34rem) { .pager { grid-template-columns: 1fr; } .pager .next { text-align: left; } }
</style>

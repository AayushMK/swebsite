---
import Base from '../../layouts/Base.astro';
import { getPosts, TOPICS, SITE, url, formatDate, readingTime, type Post } from '../../lib/site';

export function getStaticPaths() {
  const posts = getPosts();
  return posts.map((post, i) => ({
    params: { slug: post.slug },
    props: { post, newer: posts[i - 1], older: posts[i + 1] },
  }));
}

interface Props {
  post: Post;
  newer?: Post;
  older?: Post;
}
const { post, newer, older } = Astro.props;
const { Content } = post;
---
<Base title={post.title} description={post.description}>
  <div class="progress" aria-hidden="true"></div>
  <article class="wrap">
    <header>
      <p class="meta">
        <a href={url('writing/')}>{TOPICS[post.topic]}</a>
        <time datetime={post.date.toISOString()}>{formatDate(post.date)}</time>
        <span>{readingTime(post.words)}</span>
      </p>
      <h1>{post.title}</h1>
      <p class="lede">{post.description}</p>
    </header>
    <div class="prose">
      <Content />
    </div>
    <p class="reply">
      Thoughts on this, or disagree with me? <a href={`mailto:${SITE.email}?subject=${encodeURIComponent(post.title)}`}>Write to me</a>.
    </p>
  </article>

  {(newer || older) && (
    <nav class="wrap pager" aria-label="More writing">
      {older ? (
        <a href={url(`writing/${older.slug}/`)}><span>Older</span>{older.title}</a>
      ) : <span />}
      {newer && (
        <a class="next" href={url(`writing/${newer.slug}/`)}><span>Newer</span>{newer.title}</a>
      )}
    </nav>
  )}
</Base>

<style>
  article { padding-top: clamp(2.5rem, 7vw, 4.5rem); }
  header { max-width: 50rem; margin-bottom: 3rem; }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.5rem;
    margin: 0;
    font-family: var(--sans);
    font-size: var(--step--1);
    color: var(--ink-soft);
  }
  .meta a { font-weight: 600; color: var(--ink); text-decoration: none; }
  h1 {
    margin: 1rem 0 0;
    font-family: var(--sans);
    font-size: var(--step-4);
    font-weight: 750;
    font-stretch: 80%;
    line-height: 0.98;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }
  .lede { max-width: var(--measure); margin: 1.5rem 0 0; font-size: var(--step-1); font-style: italic; line-height: 1.4; color: var(--ink-soft); }
  .reply { max-width: var(--measure); margin: 4rem 0 0; padding-top: 1.5rem; border-top: 1.5px solid var(--ink); font-style: italic; }
  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    margin-top: 4rem;
    padding-bottom: 2rem;
  }
  .pager a { font-family: var(--sans); font-size: var(--step-1); font-weight: 600; line-height: 1.2; letter-spacing: -0.015em; text-decoration: none; }
  .pager a:hover { text-decoration: underline; }
  .pager span { display: block; margin-bottom: 0.3rem; font-size: var(--step--1); font-weight: 400; color: var(--ink-soft); }
  .pager .next { text-align: right; }

  /* Reading progress, where the browser supports scroll-linked animation */
  .progress { display: none; }
  @supports (animation-timeline: scroll()) {
    .progress {
      display: block;
      position: fixed;
      top: 0; left: 0; right: 0;
      z-index: 20;
      height: 3px;
      background: var(--ink);
      transform-origin: left;
      animation: read linear both;
      animation-timeline: scroll(root);
    }
    @keyframes read { from { transform: scaleX(0); } to { transform: scaleX(1); } }
  }
  @media (max-width: 34rem) {
    .pager { grid-template-columns: 1fr; }
    .pager .next { text-align: left; }
  }
</style>
